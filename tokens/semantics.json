{
  "role": {
    "typography": {
      "heading": {
        "display": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.heading}",
            "fontSize": "{dimension.font-size.7xl}",
            "fontWeight": "{font-weight.black}",
            "lineHeight": "{line-height.none}",
            "letterSpacing": "{letter-spacing.tighter}"
          },
          "$description": "Display — hero / splash text (72px)"
        },
        "h1": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.heading}",
            "fontSize": "{dimension.font-size.5xl}",
            "fontWeight": "{font-weight.bold}",
            "lineHeight": "{line-height.tight}",
            "letterSpacing": "{letter-spacing.tight}"
          },
          "$description": "H1 — primary page title (48px)"
        },
        "h2": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.heading}",
            "fontSize": "{dimension.font-size.4xl}",
            "fontWeight": "{font-weight.bold}",
            "lineHeight": "{line-height.tight}",
            "letterSpacing": "{letter-spacing.tight}"
          },
          "$description": "H2 — section title (36px)"
        },
        "h3": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.heading}",
            "fontSize": "{dimension.font-size.3xl}",
            "fontWeight": "{font-weight.bold}",
            "lineHeight": "{line-height.snug}",
            "letterSpacing": "{letter-spacing.normal}"
          },
          "$description": "H3 — subsection title (30px)"
        },
        "h4": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.heading}",
            "fontSize": "{dimension.font-size.2xl}",
            "fontWeight": "{font-weight.bold}",
            "lineHeight": "{line-height.snug}",
            "letterSpacing": "{letter-spacing.normal}"
          },
          "$description": "H4 — card / panel title (24px)"
        }
      },
      "body": {
        "lg": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.body}",
            "fontSize": "{dimension.font-size.lg}",
            "fontWeight": "{font-weight.regular}",
            "lineHeight": "{line-height.normal}",
            "letterSpacing": "{letter-spacing.normal}"
          },
          "$description": "Body large — introductory paragraphs (18px)"
        },
        "md": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.body}",
            "fontSize": "{dimension.font-size.md}",
            "fontWeight": "{font-weight.regular}",
            "lineHeight": "{line-height.normal}",
            "letterSpacing": "{letter-spacing.normal}"
          },
          "$description": "Body medium — default body text (16px)"
        },
        "sm": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.body}",
            "fontSize": "{dimension.font-size.sm}",
            "fontWeight": "{font-weight.regular}",
            "lineHeight": "{line-height.relaxed}",
            "letterSpacing": "{letter-spacing.normal}"
          },
          "$description": "Body small — secondary copy (14px)"
        },
        "xs": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.body}",
            "fontSize": "{dimension.font-size.xs}",
            "fontWeight": "{font-weight.regular}",
            "lineHeight": "{line-height.relaxed}",
            "letterSpacing": "{letter-spacing.normal}"
          },
          "$description": "Body xsmall — footnotes, helper text (12px)"
        }
      },
      "label": {
        "lg": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.body}",
            "fontSize": "{dimension.font-size.sm}",
            "fontWeight": "{font-weight.medium}",
            "lineHeight": "{line-height.snug}",
            "letterSpacing": "{letter-spacing.wide}"
          },
          "$description": "Label large — form labels, nav items (14px medium)"
        },
        "md": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.body}",
            "fontSize": "{dimension.font-size.xs}",
            "fontWeight": "{font-weight.medium}",
            "lineHeight": "{line-height.snug}",
            "letterSpacing": "{letter-spacing.wide}"
          },
          "$description": "Label medium — badges, tabs (12px medium)"
        },
        "sm": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font-family.body}",
            "fontSize": "{dimension.font-size.2xs}",
            "fontWeight": "{font-weight.medium}",
            "lineHeight": "{line-height.loose}",
            "letterSpacing": "{letter-spacing.wider}"
          },
          "$description": "Label small — chips, micro labels (10px medium)"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font-family.body}",
          "fontSize": "{dimension.font-size.xs}",
          "fontWeight": "{font-weight.regular}",
          "lineHeight": "{line-height.loose}",
          "letterSpacing": "{letter-spacing.wide}"
        },
        "$description": "Caption — image captions, timestamps (12px regular)"
      },
      "metric": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font-family.mono}",
          "fontSize": "{dimension.font-size.3xl}",
          "fontWeight": "{font-weight.medium}",
          "lineHeight": "{line-height.tight}",
          "letterSpacing": "{letter-spacing.normal}"
        }
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": "{dimension.radius.none}",
        "$description": "No rounding — flush / sharp corners"
      },
      "subtle": {
        "$type": "dimension",
        "$value": "{dimension.radius.sm}",
        "$description": "Minimal rounding for compact or tight elements"
      },
      "default": {
        "$type": "dimension",
        "$value": "{dimension.radius.md}",
        "$description": "Standard rounding — most interactive UI"
      },
      "prominent": {
        "$type": "dimension",
        "$value": "{dimension.radius.xl}",
        "$description": "Strong rounding for surfaces and containers"
      },
      "expressive": {
        "$type": "dimension",
        "$value": "{dimension.radius.2xl}",
        "$description": "Large rounding for hero surfaces and dialogs"
      },
      "pill": {
        "$type": "dimension",
        "$value": "{dimension.radius.full}",
        "$description": "Full pill / circular shape"
      }
    },
    "shadow": {
      "flat": {
        "$type": "shadow",
        "$value": [
          {
            "color": "#0A112800",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px",
            "inset": false
          }
        ],
        "$description": "No elevation"
      },
      "low": {
        "$type": "shadow",
        "$value": "{shadow.sm}",
        "$description": "Subtle lift — interactive elements"
      },
      "medium": {
        "$type": "shadow",
        "$value": "{shadow.md}",
        "$description": "Standard elevation — cards, dropdowns"
      },
      "high": {
        "$type": "shadow",
        "$value": "{shadow.lg}",
        "$description": "Prominent elevation — floating panels, popovers"
      },
      "highest": {
        "$type": "shadow",
        "$value": "{shadow.xl}",
        "$description": "Maximum elevation — modals, drawers"
      }
    },
    "border-width": {
      "default": {
        "$type": "dimension",
        "$value": "{dimension.border-width.thin}",
        "$description": "Standard border thickness"
      },
      "emphasis": {
        "$type": "dimension",
        "$value": "{dimension.border-width.medium}",
        "$description": "Highlighted or focus-state border"
      },
      "strong": {
        "$type": "dimension",
        "$value": "{dimension.border-width.thick}",
        "$description": "Heavy stroke for bold visual separation"
      }
    },
    "elevation": {
      "card": {
        "$type": "shadow",
        "$value": [
          {
            "color": "#00000000",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px"
          }
        ],
        "$description": "Profondeur d'une carte — **en plus de sa bordure, jamais à sa place**. Produit : aucune. Une interface de travail dense se lit mieux à plat, et l'ombre y devient du bruit. Marketing : deux couches transparentes.\n\nLa skill `better-ui` recommande de remplacer la bordure par un anneau d'ombre à 6 % — on s'en écarte, et c'est mesuré : cet anneau donne 1,18:1 contre la page en clair et **1,00 en sombre**, soit moins que la bordure qu'il remplacerait (1,22 à 1,44). La carte disparaîtrait. La bordure porte la structure, l'ombre ne porte que l'élévation."
      },
      "card-hover": {
        "$type": "shadow",
        "$value": [
          {
            "color": "#00000000",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px"
          }
        ],
        "$description": "État survolé. Produit : toujours aucune profondeur."
      }
    }
  }
}
