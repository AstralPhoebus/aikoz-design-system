{
  "name": "aikoz-design-system",
  "version": "2.7.1",
  "description": "Dépôt de référence pour tout contenu visuel et éditorial Aikoz by Okuden.   Il contient les sources de vérité — design tokens, voix de marque, logos, polices — que l'équipe injecte dans ses outils IA et ses productions.",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build:tokens": "node build-tokens.mjs",
    "registry:build": "shadcn build && node scripts/version-publiee.mjs && node scripts/chiffres.mjs",
    "test": "vitest --run",
    "build:preview": "npm run build:tokens && vite build",
    "build": "npm run build:tokens && npm run registry:build && vite build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "audit:marques": "python3 scripts/audit-etancheite.py",
    "audit:registry": "node scripts/audit-registry.mjs",
    "audit:typo": "node scripts/audit-typo.mjs",
    "audit:mouvement": "node scripts/audit-mouvement.mjs",
    "audit:conventions": "node scripts/audit-conventions.mjs",
    "audit:version": "node scripts/audit-version.mjs",
    "version:publier": "node scripts/version-publiee.mjs",
    "build:chiffres": "node scripts/chiffres.mjs"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.16",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.12.0",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Voice-of-Customers-by-Okuden/aikoz-design-system.git"
  },
  "keywords": [],
